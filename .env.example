# Create credentials at https://web3.binance.com/en/dev-portal
BINANCE_WEB3_API_KEY=your-api-key
BINANCE_WEB3_SECRET_KEY=your-secret-key

# Optional: verify omitted token balances with ERC-20 balanceOf on BSC.
# FLOW_BNB_RPC_URL=https://bsc-dataseed.bnbchain.org
# Required for MCP prepare_trade; this file is chosen by the operator, not the agent.
# FLOW_BNB_POLICY_FILE=/absolute/path/to/flow-bnb/examples/policy.json

# Optional operator inbox for MCP intent queueing; use an absolute, private 0700 directory.
# FLOW_BNB_HANDOFF_DIR=/absolute/path/to/trade-inbox
